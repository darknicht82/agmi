# A&G Market Intelligence — variables de entorno
# Copiar a .env y completar. NUNCA subir .env al repositorio.
# Regla cero fallbacks: toda variable marcada como OBLIGATORIA debe existir;
# si falta, el sistema falla con error duro (no hay valor por defecto silencioso).

# --- Base de datos (OBLIGATORIA) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agmarket
POSTGRES_USER=agmarket
POSTGRES_PASSWORD=

# --- Almacenamiento (OBLIGATORIA) ---
DATA_DIR=./data

# --- HTTP / crawling (OBLIGATORIAS) ---
# Rate limit: máx. de requests por minuto por dominio
CRAWL_RATE_LIMIT_PER_MIN=6
# Timeouts y límites de seguridad (SSRF / payloads)
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RESPONSE_BYTES=10485760
HTTP_MAX_REDIRECTS=3

# --- Inferencia local (opcional hasta Fase 2) ---
# Dejar vacío y el sistema falla al intentar extraer si no hay proveedor.
LLM_PROVIDER=
LLM_MODEL=
LLM_ENDPOINT=

# --- Observabilidad ---
RUN_ENV=dev
LOG_LEVEL=INFO
